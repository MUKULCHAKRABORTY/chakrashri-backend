# --- Server ---
NODE_ENV=production
PORT=4000
CLIENT_URL=https://www.chakrashri.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://chakrashri_user:CHANGE_ME@localhost:5432/chakrashri_db
DB_SSL=true

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_64_char_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# --- Razorpay (get from https://dashboard.razorpay.com after KYC) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_set_in_razorpay_dashboard

# --- Email (transactional: order confirmations, OTPs) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@chakrashri.com
SMTP_PASS=your_smtp_password
FROM_EMAIL="Chakrashri <noreply@chakrashri.com>"

# --- SMS/WhatsApp (optional, e.g. MSG91 / Twilio / Gupshup) ---
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# --- Shipping (e.g. Shiprocket) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- File storage for product images (e.g. AWS S3 / Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Abandoned-checkout expiry sweep (scripts/release-expired-orders.js) ---
ORDER_RESERVATION_EXPIRY_MINUTES=30
