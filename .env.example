# =============================================================================
# Chakrashri API — environment template
#
# Copy to .env for local development. NEVER commit .env, and never send it in a
# zip: the audit found a .env carrying live database, JWT, Razorpay and SMTP
# credentials inside the delivered archive. .gitignore already excludes it;
# packaging is the other half.
#
# Required values are marked REQUIRED. The server refuses to start without them
# (see the fail-fast block at the top of src/server.js) rather than starting,
# reporting itself healthy, and failing on the first login.
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=production
PORT=4000
CLIENT_URL=https://www.chakrashri.com          # REQUIRED in production. No trailing slash.
ADDITIONAL_CLIENT_ORIGINS=                     # optional, comma-separated — Netlify branch previews

# The business runs in IST. Render defaults to UTC, which put evening sales in
# the next day's revenue bucket and rejected valid same-day bookings made before
# 05:30 (BIZ-06). src/server.js defaults this, but set it explicitly.
TZ=Asia/Kolkata

# --- Database (PostgreSQL) ---------------------------------------------------
# For a MANAGED database (Neon, RDS, Supabase) end the URL with sslmode=verify-full:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=verify-full
#
# Use verify-full, not require. pg currently treats 'require' as an alias for
# verify-full, but pg v9 will adopt libpq semantics where 'require' means
# encrypted but NOT certificate-verified — a man-in-the-middle window that opens
# on a routine dependency bump, with no error and no failing test. src/config/db.js
# rewrites require/verify-ca to verify-full at boot and logs that it did so;
# setting it here means the code has nothing to correct. (DB_SSL_NORMALIZE=false
# disables that rewrite if you ever need the raw value honoured.)
DATABASE_URL=postgresql://chakrashri_user:CHANGE_ME@localhost:5432/chakrashri_db  # REQUIRED
# Only consulted when DATABASE_URL carries no sslmode of its own — a parsed
# sslmode always wins. Leave unset for a local Postgres that speaks no TLS.
DB_SSL=true

# A DISPOSABLE database for `npm run test:db-integration`. Those 29 tests create
# and delete rows, so they must never touch production — which is exactly why
# they read this variable rather than DATABASE_URL above. Leave it unset and they
# skip (loudly); set it and they run.
#
# A Neon branch of your project is the easiest option: instant, free, isolated,
# and thrown away afterwards. A second database named chakrashri_test works too.
# Apply the migrations to it once before the first run, by pointing DATABASE_URL
# at it for that single `npm run migrate`.
#
# A safety guard refuses anything that does not look disposable: the HOST must be
# localhost, or the DATABASE NAME must contain "test" or "ci" as a whole word.
# The credentials are deliberately not examined — a password should never be able
# to grant permission to write to a database.

TEST_DATABASE_URL=postgresql://postgres@localhost:5432/chakrashri_test


DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=20000
DB_TX_MAX_ATTEMPTS=3                           # retries on deadlock/serialization failure (40P01/40001)

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_64_char_string    # REQUIRED
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# AUTH-03 rollout switch. Tokens issued before token_version shipped carry no
# `tv` claim. Leave false for one JWT_EXPIRES_IN window (7 days) so the deploy
# does not sign every customer out mid-session, then set to true to close the
# grace period permanently. After that, a password reset genuinely ends every
# existing session — which is what a worried customer believes it already does.
REQUIRE_TOKEN_VERSION=false
TOKEN_VERSION_CACHE_MS=10000

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
REGISTER_RATE_LIMIT_MAX=10                     # per IP per hour
EMAIL_DISPATCH_RATE_LIMIT_MAX=5                # password reset / verification emails, per IP per hour
CHECKOUT_RATE_LIMIT_MAX=20                     # per user per 15 min
BOOKING_RATE_LIMIT_MAX=20
COUPON_VALIDATE_RATE_LIMIT_MAX=10              # blocks coupon-code dictionary attacks (BIZ-01)
REVIEW_RATE_LIMIT_MAX=5                        # per user per hour
SUPPORT_CHAT_RATE_LIMIT_MAX=30                 # per user per hour — this one costs money per call

# --- Razorpay ----------------------------------------------------------------
# All three REQUIRED in production. Get them from dashboard.razorpay.com.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_set_in_razorpay_dashboard

# Subscribe the webhook to: payment.captured, payment.failed, refund.processed,
# refund.created. The refund events are what keep the books honest when someone
# refunds from the Razorpay dashboard instead of the admin panel.

# --- Email (transactional: order confirmations, password resets, verification) -
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@chakrashri.com
SMTP_PASS=your_smtp_password
FROM_EMAIL="Chakrashri <noreply@chakrashri.com>"

# --- Support assistant (optional) --------------------------------------------
# The storefront chat widget calls /api/support/chat, which proxies to the model
# with the key held server-side. Leave ANTHROPIC_API_KEY unset and the endpoint
# returns 501; the widget then shows the WhatsApp number instead of an error.
# NEVER put this key in index.html — a key in client-side JavaScript is public.
ANTHROPIC_API_KEY=
SUPPORT_ASSISTANT_MODEL=claude-sonnet-4-5
SUPPORT_ASSISTANT_MAX_TOKENS=600
SUPPORT_ASSISTANT_TIMEOUT_MS=20000

# --- Background jobs ---------------------------------------------------------
# Both are declared as cron services in render.yaml.
ORDER_RESERVATION_EXPIRY_MINUTES=30            # overridden by the site_settings row of the same name
RECONCILE_LOOKBACK_HOURS=72

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info                                 # debug | info | warn | error
SHUTDOWN_GRACE_MS=10000

# --- Sitemap generation (storefront build) -----------------------------------
SITE_ORIGIN=https://www.chakrashri.com
API_BASE=https://chakrashri-api.onrender.com

# --- Not yet wired up --------------------------------------------------------
# Present so the intent is visible; nothing reads them today.
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
